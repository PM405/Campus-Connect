<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Forgot Password | CampusConnect
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>

<body class="forgot-password-page">

    <main class="forgot-password-container">

        <div class="forgot-password-card">

            <div class="forgot-password-icon">
                <i class="fa-solid fa-key"></i>
            </div>

            <h1>
                Forgot Password?
            </h1>

            <p>
                Enter your registered email address
                and we will send you a password reset link.
            </p>

            <% if (typeof message !== "undefined") { %>

                <div class="forgot-password-message">
                    <i class="fa-solid fa-circle-check"></i>
                    <%= message %>
                </div>

            <% } %>

            <form
                action="/forgot-password"
                method="POST"
            >

                <div class="forgot-password-field">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="forgot-password-input">

                        <i class="fa-solid fa-envelope"></i>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your registered email"
                            required
                        >

                    </div>

                </div>

                <button
                    type="submit"
                    class="forgot-password-btn"
                >
                    <i class="fa-solid fa-paper-plane"></i>
                    Send Reset Link
                </button>

            </form>

            <a
                href="/login"
                class="forgot-password-back"
            >
                <i class="fa-solid fa-arrow-left"></i>
                Back to Login
            </a>

        </div>

    </main>

    <footer>

        <p>
            © 2026 CampusConnect | Student & Faculty Collaboration Portal
        </p>

        <p>
            Developed & Designed by
            <strong>Prince Mishra</strong>
        </p>

    </footer>

</body>

</html>