<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Notices - CampusConnect</title>

    <link rel="stylesheet" href="/style.css">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>

<body>

<div class="notice-page">

    <div class="notice-container">

        <div class="notice-topbar">

            <a
                href="/teacher/dashboard"
                class="back-btn"
            >
                <i class="fa-solid fa-arrow-left"></i>
                Back to Dashboard
            </a>

            <a
                href="/teacher/notices/create"
                class="create-btn"
            >
                <i class="fa-solid fa-plus"></i>
                Create Notice
            </a>

        </div>

        <div class="notice-header">

            <div class="notice-header-icon">
                <i class="fa-solid fa-bullhorn"></i>
            </div>

            <div>
                <h1>My Notices</h1>

                <p>
                    Manage notices for your courses.
                </p>
            </div>

        </div>

        <% if (notices && notices.length > 0) { %>

            <div class="notice-list">

                <% notices.forEach(notice => { %>

                    <div class="notice-card">

                        <div class="notice-card-top">

                            <div class="notice-icon">
                                <i class="fa-solid fa-bullhorn"></i>
                            </div>

                            <span class="notice-badge">
                                Notice
                            </span>

                        </div>

                        <h2>
                            <%= notice.title %>
                        </h2>

                        <p class="notice-description">
                            <%= notice.description %>
                        </p>

                        <div class="notice-meta">

                            <span>
                                <i class="fa-solid fa-book"></i>

                                <%= notice.course
                                    ? notice.course.courseName
                                    : "Unknown Course" %>

                            </span>

                            <span>
                                <i class="fa-solid fa-graduation-cap"></i>

                                <%= notice.course
                                    ? notice.course.subject
                                    : "Unknown Subject" %>

                            </span>

                            <span>
                                <i class="fa-regular fa-calendar"></i>

                                <%= new Date(
                                    notice.createdAt
                                ).toLocaleDateString(
                                    "en-IN",
                                    {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric"
                                    }
                                ) %>

                            </span>

                        </div>

                        <form
                            action="/teacher/notices/<%= notice._id %>/delete"
                            method="POST"
                            onsubmit="return confirm('Delete this notice?')"
                        >

                            <button
                                type="submit"
                                class="delete-btn"
                            >
                                <i class="fa-solid fa-trash"></i>
                                Delete
                            </button>

                        </form>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-bullhorn"></i>
                </div>

                <h2>No notices yet</h2>

                <p>
                    Create your first notice for your students.
                </p>

                <a
                    href="/teacher/notices/create"
                    class="create-btn"
                >
                    <i class="fa-solid fa-plus"></i>
                    Create Notice
                </a>

            </div>

        <% } %>

    </div>

</div>

<style>

.notice-page {
    min-height: 100vh;
    background: #f5f7fb;
    padding: 40px 20px;
}

.notice-container {
    max-width: 1100px;
    margin: 0 auto;
}

.notice-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
}

.back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #4f46e5;
    text-decoration: none;
    font-weight: 600;
}

.create-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #4f46e5;
    color: white;
    padding: 11px 18px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
}

.create-btn:hover {
    background: #4338ca;
}

.notice-header {
    display: flex;
    align-items: center;
    gap: 18px;
    background: white;
    padding: 25px;
    border-radius: 16px;
    margin-bottom: 25px;
}

.notice-header-icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2ff;
    color: #4f46e5;
    border-radius: 14px;
    font-size: 25px;
}

.notice-header h1 {
    margin: 0 0 5px;
}

.notice-header p {
    margin: 0;
    color: #6b7280;
}

.notice-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.notice-card {
    background: white;
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
}

.notice-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.notice-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2ff;
    color: #4f46e5;
    border-radius: 12px;
}

.notice-badge {
    background: #eef2ff;
    color: #4f46e5;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
}

.notice-card h2 {
    margin: 0 0 10px;
    color: #111827;
    font-size: 20px;
}

.notice-description {
    color: #6b7280;
    line-height: 1.6;
}

.notice-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 18px 0;
    padding-top: 15px;
    border-top: 1px solid #e5e7eb;
}

.notice-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #6b7280;
    font-size: 12px;
}

.notice-meta i {
    color: #4f46e5;
}

.delete-btn {
    border: none;
    background: #fee2e2;
    color: #dc2626;
    padding: 9px 13px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
}

.empty-state {
    text-align: center;
    background: white;
    padding: 70px 25px;
    border-radius: 18px;
}

.empty-icon {
    width: 75px;
    height: 75px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2ff;
    color: #4f46e5;
    border-radius: 50%;
    font-size: 30px;
}

.empty-state h2 {
    margin-bottom: 10px;
}

.empty-state p {
    color: #6b7280;
    margin-bottom: 25px;
}

@media (max-width: 700px) {

    .notice-page {
        padding: 25px 12px;
    }

    .notice-list {
        grid-template-columns: 1fr;
    }

    .notice-topbar {
        gap: 10px;
    }

    .create-btn {
        padding: 9px 12px;
        font-size: 13px;
    }

}

</style>

</body>
</html>