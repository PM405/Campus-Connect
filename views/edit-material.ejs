<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Study Material | CampusConnect</title>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #1f2937;
            min-height: 100vh;
        }

        .navbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 7%;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #2563eb;
            font-size: 21px;
            font-weight: 700;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #2563eb;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .back-btn {
            text-decoration: none;
            color: #4b5563;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .back-btn:hover {
            color: #2563eb;
        }

        .page {
            max-width: 900px;
            margin: 45px auto;
            padding: 0 20px;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .page-heading h1 {
            font-size: 30px;
            margin-bottom: 8px;
            color: #111827;
        }

        .page-heading p {
            color: #6b7280;
            font-size: 15px;
        }

        .form-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 18px;
            padding: 32px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
        }

        .course-info {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #ecfdf5;
            border: 1px solid #d1fae5;
            padding: 15px 18px;
            border-radius: 12px;
            margin-bottom: 28px;
        }

        .course-info i {
            color: #059669;
            font-size: 18px;
        }

        .course-info strong {
            color: #047857;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 8px;
        }

        .input-box {
            position: relative;
        }

        .input-box i {
            position: absolute;
            left: 15px;
            top: 16px;
            color: #9ca3af;
        }

        input,
        textarea {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            padding: 13px 15px 13px 43px;
            font-size: 14px;
            outline: none;
            transition: 0.2s;
            background: #ffffff;
            color: #111827;
        }

        textarea {
            min-height: 150px;
            resize: vertical;
            padding-left: 15px;
            line-height: 1.6;
        }

        input:focus,
        textarea:focus {
            border-color: #059669;
            box-shadow: 0 0 0 3px #d1fae5;
        }

        .link-preview {
            margin-top: 8px;
            padding: 10px 12px;
            background: #f9fafb;
            border-radius: 8px;
            font-size: 12px;
            color: #6b7280;
            word-break: break-all;
        }

        .link-preview i {
            color: #059669;
            margin-right: 5px;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid #e5e7eb;
        }

        .btn {
            border: none;
            border-radius: 10px;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .cancel-btn {
            background: #f3f4f6;
            color: #374151;
        }

        .cancel-btn:hover {
            background: #e5e7eb;
        }

        .save-btn {
            background: #059669;
            color: white;
        }

        .save-btn:hover {
            background: #047857;
        }

        .required {
            color: #dc2626;
        }

        .footer-note {
            text-align: center;
            margin-top: 20px;
            color: #9ca3af;
            font-size: 12px;
        }

        @media (max-width: 650px) {
            .navbar {
                padding: 0 20px;
            }

            .page {
                margin: 30px auto;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .form-card {
                padding: 22px;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .back-btn span {
                display: none;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">

        <a href="/teacher/dashboard" class="logo">
            <span class="logo-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </span>
            CampusConnect
        </a>

        <a href="/course/<%= material.course._id %>" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Course</span>
        </a>

    </nav>

    <main class="page">

        <div class="page-heading">
            <h1>Edit Study Material</h1>
            <p>Update the study material information and save your changes.</p>
        </div>

        <div class="form-card">

            <div class="course-info">

                <i class="fa-solid fa-book-open"></i>

                <div>
                    <small>Course</small>

                    <div>
                        <strong>
                            <%= material.course.courseName %>
                        </strong>
                    </div>
                </div>

            </div>

            <form
                action="/teacher/materials/<%= material._id %>/edit"
                method="POST"
            >

                <div class="form-group">

                    <label>
                        Material Title
                        <span class="required">*</span>
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-file-lines"></i>

                        <input
                            type="text"
                            name="title"
                            value="<%= material.title %>"
                            placeholder="Enter material title"
                            required
                        >

                    </div>

                </div>

                <div class="form-group">

                    <label>
                        Description
                        <span class="required">*</span>
                    </label>

                    <textarea
                        name="description"
                        placeholder="Enter material description"
                        required
                    ><%= material.description %></textarea>

                </div>

                <div class="form-group">

                    <label>
                        Material Link
                        <span class="required">*</span>
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-link"></i>

                        <input
                            type="url"
                            name="materialLink"
                            value="<%= material.materialLink %>"
                            placeholder="https://example.com/material"
                            required
                        >

                    </div>

                    <div class="link-preview">
                        <i class="fa-solid fa-circle-info"></i>
                        Make sure the link is accessible to your students.
                    </div>

                </div>

                <div class="form-group">

                    <label>
                        Added On
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-clock"></i>

                        <input
                            type="text"
                            value="<%= new Date(material.createdAt).toLocaleDateString() %>"
                            readonly
                        >

                    </div>

                </div>

                <div class="form-actions">

                    <a
                        href="/course/<%= material.course._id %>"
                        class="btn cancel-btn"
                    >
                        <i class="fa-solid fa-xmark"></i>
                        Cancel
                    </a>

                    <button
                        type="submit"
                        class="btn save-btn"
                    >
                        <i class="fa-solid fa-check"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

        <div class="footer-note">
            CampusConnect • Study Material Management
        </div>

    </main>

</body>
</html>