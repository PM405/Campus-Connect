<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Course | CampusConnect</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="form-container">
    <h1>Create New Course</h1>
    <p class="form-subtitle">Add a new course for your students</p>

    <form action="/teacher/courses/new" method="POST">

        <div class="form-group">
            <label>Course Name</label>
            <input
                type="text"
                name="courseName"
                placeholder="Example: B.Tech in Computer Science"
                required
            >
        </div>

        <div class="form-group">
            <label>Subject</label>
            <input
                type="text"
                name="subject"
                placeholder="Example: Data Mining"
                required
            >
        </div>


        <div class="form-group">
            <label>Start Date</label>
            <input
                type="date"
                name="startDate"
                required
            >
        </div>

        <div class="form-group">
            <label>End Date</label>
            <input
                type="date"
                name="endDate"
                required
            >
        </div>

        <button type="submit" class="primary-btn">
            Create Course
        </button>

    </form>

    <a href="/teacher/dashboard" class="back-link">
        ← Back to Dashboard
    </a>
</div>

</body>
</html>