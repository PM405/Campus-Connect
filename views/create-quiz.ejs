<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Quiz - CampusConnect</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>

<body>

<div class="create-quiz-page">

    <div class="create-quiz-container">

        <a
            href="/teacher/quizzes"
            class="quiz-back-btn"
        >
            <i class="fa-solid fa-arrow-left"></i>
            Back to My Quizzes
        </a>


        <div class="create-quiz-header">

            <div class="create-quiz-icon">
                <i class="fa-solid fa-brain"></i>
            </div>

            <div>

                <span>TEACHER</span>

                <h1>Create Quiz</h1>

                <p>
                    Create a quiz for your students.
                </p>

            </div>

        </div>


        <form
            action="/teacher/quizzes/create"
            method="POST"
            id="quizForm"
        >

            <!-- Basic Information -->

            <div class="quiz-form-card">

                <h2>
                    <i class="fa-solid fa-circle-info"></i>
                    Quiz Information
                </h2>


                <div class="form-group">

                    <label>
                        Quiz Title
                    </label>

                    <input
                        type="text"
                        name="title"
                        placeholder="Enter quiz title"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Description
                    </label>

                    <textarea
                        name="description"
                        rows="4"
                        placeholder="Enter quiz description"
                        required
                    ></textarea>

                </div>


                <div class="form-group">

                    <label>
                        Select Course
                    </label>

                    <select
                        name="courseId"
                        required
                    >

                        <option value="">
                            -- Select Course --
                        </option>

                        <% if (courses && courses.length > 0) { %>

                            <% courses.forEach(course => { %>

                                <option value="<%= course._id %>">

                                    <%= course.courseName %>

                                    -

                                    <%= course.subject %>

                                </option>

                            <% }) %>

                        <% } %>

                    </select>

                </div>

            </div>


            <!-- Questions -->

            <div class="quiz-form-card">

                <div class="questions-header">

                    <h2>
                        <i class="fa-solid fa-list-check"></i>
                        Questions
                    </h2>

                    <button
                        type="button"
                        class="add-question-btn"
                        onclick="addQuestion()"
                    >
                        <i class="fa-solid fa-plus"></i>
                        Add Question
                    </button>

                </div>


                <div id="questionsContainer">


                    <!-- Question 1 -->

                    <div class="question-box">

                        <div class="question-box-header">

                            <span>
                                Question 1
                            </span>

                        </div>


                        <div class="form-group">

                            <label>
                                Question
                            </label>

                            <input
                                type="text"
                                name="question"
                                placeholder="Enter question"
                                required
                            >

                        </div>


                        <div class="options-grid">


                            <div class="form-group">

                                <label>
                                    Option 1
                                </label>

                                <input
                                    type="text"
                                    name="option1"
                                    placeholder="Enter option 1"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label>
                                    Option 2
                                </label>

                                <input
                                    type="text"
                                    name="option2"
                                    placeholder="Enter option 2"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label>
                                    Option 3
                                </label>

                                <input
                                    type="text"
                                    name="option3"
                                    placeholder="Enter option 3"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label>
                                    Option 4
                                </label>

                                <input
                                    type="text"
                                    name="option4"
                                    placeholder="Enter option 4"
                                    required
                                >

                            </div>

                        </div>


                        <div class="answer-row">


                            <div class="form-group">

                                <label>
                                    Correct Answer
                                </label>

                                <select
                                    name="correctAnswer"
                                    required
                                >

                                    <option value="">
                                        Select correct option
                                    </option>

                                    <option value="1">
                                        Option 1
                                    </option>

                                    <option value="2">
                                        Option 2
                                    </option>

                                    <option value="3">
                                        Option 3
                                    </option>

                                    <option value="4">
                                        Option 4
                                    </option>

                                </select>

                            </div>


                            <div class="form-group">

                                <label>
                                    Marks
                                </label>

                                <input
                                    type="number"
                                    name="marks"
                                    value="1"
                                    min="1"
                                    required
                                >

                            </div>

                        </div>

                    </div>


                </div>

            </div>


            <!-- Submit -->

            <div class="quiz-submit-area">

                <p>
                    <i class="fa-solid fa-circle-info"></i>
                    Check all questions before creating the quiz.
                </p>

                <button
                    type="submit"
                    class="create-quiz-btn"
                >

                    <i class="fa-solid fa-circle-check"></i>

                    Create Quiz

                </button>

            </div>


        </form>

    </div>

</div>


<style>

/* Page */

.create-quiz-page {
    min-height: 100vh;
    background: #f5f7fb;
    padding: 40px 20px;
}

.create-quiz-container {
    max-width: 900px;
    margin: auto;
}


/* Back Button */

.quiz-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #4f46e5;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 25px;
}

.quiz-back-btn:hover {
    color: #3730a3;
}


/* Header */

.create-quiz-header {
    display: flex;
    align-items: center;
    gap: 20px;
    background: white;
    padding: 28px;
    border-radius: 18px;
    margin-bottom: 20px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
}

.create-quiz-icon {
    width: 65px;
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fef3c7;
    color: #d97706;
    border-radius: 15px;
    font-size: 28px;
    flex-shrink: 0;
}

.create-quiz-header span {
    color: #6b7280;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

.create-quiz-header h1 {
    margin: 5px 0;
    color: #111827;
}

.create-quiz-header p {
    margin: 0;
    color: #6b7280;
}


/* Form Card */

.quiz-form-card {
    background: white;
    padding: 25px;
    border-radius: 16px;
    margin-bottom: 20px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
}

.quiz-form-card h2 {
    margin: 0 0 22px;
    color: #111827;
    font-size: 19px;
}

.quiz-form-card h2 i {
    color: #4f46e5;
    margin-right: 8px;
}


/* Form */

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    color: #374151;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 7px;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 12px 13px;
    font-size: 14px;
    outline: none;
    background: white;
    color: #111827;
}

.form-group textarea {
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: #4f46e5;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}


/* Questions Header */

.questions-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 22px;
}

.questions-header h2 {
    margin: 0;
}

.add-question-btn {
    border: none;
    background: #eef2ff;
    color: #4f46e5;
    padding: 10px 14px;
    border-radius: 9px;
    font-weight: 600;
    cursor: pointer;
}

.add-question-btn:hover {
    background: #e0e7ff;
}


/* Question Box */

.question-box {
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 18px;
    background: #fafafa;
}

.question-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #4f46e5;
    font-weight: 700;
    margin-bottom: 20px;
}


/* Options */

.options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}


/* Answer */

.answer-row {
    display: grid;
    grid-template-columns: 1fr 150px;
    gap: 15px;
}


/* Remove Button */

.remove-question-btn {
    border: none;
    background: #fee2e2;
    color: #dc2626;
    padding: 7px 10px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
}

.remove-question-btn:hover {
    background: #fecaca;
}


/* Submit */

.quiz-submit-area {
    background: white;
    padding: 25px;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
}

.quiz-submit-area p {
    color: #6b7280;
    font-size: 14px;
    margin-top: 0;
}

.create-quiz-btn {
    border: none;
    background: #4f46e5;
    color: white;
    padding: 13px 25px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

.create-quiz-btn:hover {
    background: #4338ca;
}


/* Mobile */

@media (max-width: 650px) {

    .create-quiz-page {
        padding: 25px 12px;
    }

    .create-quiz-header {
        padding: 20px;
    }

    .create-quiz-icon {
        width: 52px;
        height: 52px;
        font-size: 22px;
    }

    .create-quiz-header h1 {
        font-size: 23px;
    }

    .quiz-form-card {
        padding: 18px;
    }

    .questions-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .options-grid {
        grid-template-columns: 1fr;
    }

    .answer-row {
        grid-template-columns: 1fr;
    }

}

</style>


<script>

let questionNumber = 1;

function addQuestion() {

    questionNumber++;

    const container =
        document.getElementById("questionsContainer");

    const questionBox =
        document.createElement("div");

    questionBox.className = "question-box";

    questionBox.innerHTML = `

        <div class="question-box-header">

            <span>
                Question ${questionNumber}
            </span>

            <button
                type="button"
                class="remove-question-btn"
                onclick="removeQuestion(this)"
            >
                <i class="fa-solid fa-trash"></i>
                Remove
            </button>

        </div>


        <div class="form-group">

            <label>
                Question
            </label>

            <input
                type="text"
                name="question"
                placeholder="Enter question"
                required
            >

        </div>


        <div class="options-grid">

            <div class="form-group">

                <label>
                    Option 1
                </label>

                <input
                    type="text"
                    name="option1"
                    placeholder="Enter option 1"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    Option 2
                </label>

                <input
                    type="text"
                    name="option2"
                    placeholder="Enter option 2"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    Option 3
                </label>

                <input
                    type="text"
                    name="option3"
                    placeholder="Enter option 3"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    Option 4
                </label>

                <input
                    type="text"
                    name="option4"
                    placeholder="Enter option 4"
                    required
                >

            </div>

        </div>


        <div class="answer-row">

            <div class="form-group">

                <label>
                    Correct Answer
                </label>

                <select
                    name="correctAnswer"
                    required
                >

                    <option value="">
                        Select correct option
                    </option>

                    <option value="1">
                        Option 1
                    </option>

                    <option value="2">
                        Option 2
                    </option>

                    <option value="3">
                        Option 3
                    </option>

                    <option value="4">
                        Option 4
                    </option>

                </select>

            </div>


            <div class="form-group">

                <label>
                    Marks
                </label>

                <input
                    type="number"
                    name="marks"
                    value="1"
                    min="1"
                    required
                >

            </div>

        </div>

    `;

    container.appendChild(questionBox);

}


function removeQuestion(button) {

    const questionBox =
        button.closest(".question-box");

    questionBox.remove();

}

</script>


</body>

</html>