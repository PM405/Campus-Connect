<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Start Discussion | CampusConnect</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>

<body>

    <main class="form-container">

        <div class="form-icon">
            <i class="fa-solid fa-comments"></i>
        </div>

        <h1>
            Start Discussion
        </h1>

        <p class="form-subtitle">
            Ask a question or start a course discussion.
        </p>

        <form
            action="/student/discussions/create"
            method="POST"
        >

            <div class="form-group">

                <label>
                    Discussion Title
                </label>

                <input
                    type="text"
                    name="title"
                    placeholder="Example: How does K-Means work?"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    Course
                </label>

                <select
                    name="courseId"
                    required
                >

                    <option value="">
                        Select Course
                    </option>

                    <% courses.forEach(course => { %>

                        <option value="<%= course._id %>">
                            <%= course.courseName %>
                            - <%= course.subject %>
                        </option>

                    <% }) %>

                </select>

            </div>


            <div class="form-group">

                <label>
                    Description
                </label>

                <textarea
                    name="description"
                    rows="6"
                    placeholder="Write your question or discussion..."
                    required
                ></textarea>

            </div>


            <button
                type="submit"
                class="primary-btn"
            >
                <i class="fa-solid fa-paper-plane"></i>
                Post Discussion
            </button>

        </form>


        <a
            href="/student/discussions"
            class="back-link"
        >
            ← Back to Discussions
        </a>

    </main>

</body>

</html>