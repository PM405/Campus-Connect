<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CampusConnect | Student & Faculty Portal</title>

    <link rel="stylesheet" href="home.css">
</head>

<body>

    

    <nav class="navbar">

        <div class="logo">
            CampusConnect
        </div>

        <div class="nav-buttons">
            <a href="/login" class="login">Login</a>
            <a href="/register" class="register">Get Started</a>
        </div>

    </nav>


   

    <section class="hero">

        <div class="hero-content">

            <h1>
                Connect. Learn. <span>Grow.</span>
            </h1>

            <p>
                CampusConnect is a simple academic collaboration platform
                where students and teachers can manage assignments, study
                materials, quizzes, discussions and online classes in one place.
            </p>

            <a href="/register" class="hero-btn">
                Get Started →
            </a>

        </div>


        <!-- Dashboard Preview -->

        <div class="hero-card">

            <h2>Campus Dashboard</h2>

            <div class="dashboard-box">
                <strong>📚 Study Materials</strong>
                <span>
                    Access notes and learning resources
                </span>
            </div>

            <div class="dashboard-box">
                <strong>📝 Assignments</strong>
                <span>
                    Submit and track your assignments
                </span>
            </div>

            <div class="dashboard-box">
                <strong>🎯 Quizzes</strong>
                <span>
                    Test your knowledge online
                </span>
            </div>

            <div class="dashboard-box">
                <strong>💬 Discussions</strong>
                <span>
                    Ask questions and communicate
                </span>
            </div>

        </div>

    </section>


   

    <section class="features">

        <h2>Everything You Need</h2>

        <p>
            A single platform for students and faculty.
        </p>


        <div class="feature-container">

            <!-- Feature 1 -->
            <div class="feature-card">

                <div class="icon">📚</div>

                <h3>Study Materials</h3>

                <p>
                    Teachers can upload notes and learning resources
                    for students.
                </p>

            </div>


            <!-- Feature 2 -->
            <div class="feature-card">

                <div class="icon">📝</div>

                <h3>Assignments</h3>

                <p>
                    Create, submit and evaluate assignments easily.
                </p>

            </div>


            <!-- Feature 3 -->
            <div class="feature-card">

                <div class="icon">🎯</div>

                <h3>Online Quizzes</h3>

                <p>
                    Conduct quizzes and check student performance.
                </p>

            </div>


            <!-- Feature 4 -->
            <div class="feature-card">

                <div class="icon">💬</div>

                <h3>Discussion</h3>

                <p>
                    Students can ask doubts and interact with teachers.
                </p>

            </div>


            <!-- Feature 5 -->
            <div class="feature-card">

                <div class="icon">🔔</div>

                <h3>Notifications</h3>

                <p>
                    Get updates about assignments, classes and notices.
                </p>

            </div>


            <!-- Feature 6 -->
            <div class="feature-card">

                <div class="icon">💻</div>

                <h3>Online Classes</h3>

                <p>
                    Schedule and join online classes from anywhere.
                </p>

            </div>

        </div>

    </section>


   
<footer>
    <p>
        © 2026 CampusConnect | Student & Faculty Collaboration Portal
    </p>

    <p>
        Developed & Designed by
        <strong>
            <a
                href="https://codewithprince-07.github.io/Prince-Mishra-Portfolio/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Prince Mishra
            </a>
        </strong>
    </p>
</footer>



</body>
</html>