<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Reset Password | CampusConnect
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>

<body class="reset-password-page">

    <main class="reset-password-container">

        <div class="reset-password-card">

            <div class="reset-password-icon">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h1>
                Reset Password
            </h1>

            <p>
                Create a new password for your
                CampusConnect account.
            </p>

            <form
                action="/reset-password/<%= token %>"
                method="POST"
            >

                <div class="reset-password-field">

                    <label for="password">
                        New Password
                    </label>

                    <div class="reset-password-input">

                        <i class="fa-solid fa-lock"></i>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter new password"
                            minlength="6"
                            required
                        >

                    </div>

                </div>

                <div class="reset-password-field">

                    <label for="confirmPassword">
                        Confirm Password
                    </label>

                    <div class="reset-password-input">

                        <i class="fa-solid fa-shield-halved"></i>

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirm new password"
                            minlength="6"
                            required
                        >

                    </div>

                </div>

                <button
                    type="submit"
                    class="reset-password-btn"
                >
                    <i class="fa-solid fa-key"></i>
                    Reset Password
                </button>

            </form>

            <a
                href="/login"
                class="reset-password-back"
            >
                <i class="fa-solid fa-arrow-left"></i>
                Back to Login
            </a>

        </div>

    </main>

    <footer>

        <p>
            © 2026 CampusConnect | Student & Faculty Collaboration Portal
        </p>

        <p>
            Developed & Designed by
            <strong>Prince Mishra</strong>
        </p>

    </footer>

</body>

</html>