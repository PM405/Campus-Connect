<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= discussion.title %> | CampusConnect
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>


<body>


    <main class="discussion-details-page">


        <a
            href="/course/<%= discussion.course._id %>#discussions"
            class="back-link"
        >

            <i class="fa-solid fa-arrow-left"></i>

            Back to Course

        </a>


        <div class="discussion-main-card">


            <div class="discussion-course">

                <i class="fa-solid fa-book"></i>

                <%= discussion.course.courseName %>

            </div>


            <h1>

                <%= discussion.title %>

            </h1>


            <p class="discussion-description">

                <%= discussion.description %>

            </p>


            <div class="discussion-author">


                <span>

                    <i class="fa-solid fa-user"></i>

                    Posted by

                    <strong>

                        <%= discussion.student
                            ? discussion.student.name
                            : "Student"
                        %>

                    </strong>

                </span>


                <span>

                    <i class="fa-regular fa-calendar"></i>

                    <%= new Date(
                        discussion.createdAt
                    ).toLocaleString() %>

                </span>


            </div>


        </div>


        <section class="replies-section">


            <h2>

                <i class="fa-solid fa-comments"></i>

                Replies

            </h2>


            <% if (
                discussion.replies &&
                discussion.replies.length > 0
            ) { %>


                <div class="reply-list">


                    <% discussion.replies.forEach(reply => { %>


                        <div class="reply-card">


                            <div class="reply-icon">

                                <i class="fa-solid fa-user"></i>

                            </div>


                            <div>


                                <div class="reply-author">


                                    <% if (reply.teacher) { %>


                                        <strong>

                                            <%= reply.teacher.name %>

                                        </strong>


                                        <span class="teacher-badge">

                                            Teacher

                                        </span>


                                    <% } else { %>


                                        <strong>

                                            <%= reply.student
                                                ? reply.student.name
                                                : "Student"
                                            %>

                                        </strong>


                                    <% } %>


                                </div>


                                <p>

                                    <%= reply.message %>

                                </p>


                                <small>

                                    <%= new Date(
                                        reply.createdAt
                                    ).toLocaleString() %>

                                </small>


                            </div>


                        </div>


                    <% }) %>


                </div>


            <% } else { %>


                <div class="no-replies">

                    <i class="fa-regular fa-comment"></i>

                    <p>

                        No replies yet.

                    </p>

                    <span>

                        Be the first to reply to this discussion.

                    </span>

                </div>


            <% } %>


            <% if (
                isStudent ||
                isTeacher
            ) { %>


                <form
                    action="/discussions/<%= discussion._id %>/reply"
                    method="POST"
                    class="reply-form"
                >


                    <label for="message">

                        Add Reply

                    </label>


                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        placeholder="Write your reply..."
                        required
                    ></textarea>


                    <button
                        type="submit"
                        class="primary-btn"
                    >

                        <i class="fa-solid fa-paper-plane"></i>

                        Reply

                    </button>


                </form>


            <% } %>


        </section>


    </main>


</body>

</html>