<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Join Course | CampusConnect</title>

    <link rel="stylesheet" href="/style.css">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>

<body>

    <div class="join-course-page">

        <div class="join-course-card">

            <div class="join-course-icon">
                <i class="fa-solid fa-key"></i>
            </div>

            <span class="join-course-label">
                JOIN COURSE
            </span>

            <h1>Join a Course</h1>

            <p>
                Enter the unique course key shared by your teacher.
            </p>

            <form action="/student/courses/join" method="POST">

                <div class="join-input-box">

                    <i class="fa-solid fa-key"></i>

                    <input
                        type="text"
                        name="courseKey"
                        placeholder="Enter Course Key"
                        maxlength="8"
                        required
                    >

                </div>

                <button type="submit">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Join Course
                </button>

            </form>

            <a href="/student/dashboard" class="back-dashboard">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Dashboard
            </a>

        </div>

    </div>

</body>
</html>